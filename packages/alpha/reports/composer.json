{
    "name": "alpha/reports",
    "description": "Advanced reporting package for SaaSyKit platform",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Peter Warnock",
            "email": "peter@peterwarnock.com"
        }
    ],
    "require": {
